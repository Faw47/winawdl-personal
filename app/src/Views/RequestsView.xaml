<UserControl x:Class="Winawdl.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Winawdl.Views"
             Focusable="False" Foreground="{DynamicResource Ink}"
             FontFamily="{StaticResource FontText}" FontSize="14"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />
  </UserControl.Resources>

  <!-- The window around the cards is clear: the margin is where their shadows fall. -->
  <ItemsControl ItemsSource="{Binding Incoming}" Focusable="False" Margin="20,20,20,10">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <ContentControl Style="{StaticResource RaisedCard}" Width="340" Margin="0,0,0,10" Tag="arrive"
                        Loaded="OnArrived"
                        Visibility="{Binding IsAsking, Converter={StaticResource Shown}}">
          <StackPanel>
            <!-- Out of its window, a request says which app it is from. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Image Width="16" Height="16" Margin="0,0,8,0" Source="{x:Static v:RequestsView.Mark}" />
              <TextBlock Style="{StaticResource Soft}" Text="winawdl" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource Name}" TextWrapping="Wrap" TextTrimming="None"
                       Text="{Binding Headline}" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Style="{StaticResource Figures}" Margin="0,3,0,0" Text="{Binding Status}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
              <Button Style="{StaticResource RaisedButton}" Content="Decline" Margin="0,0,10,0"
                      Command="{Binding Decline}" />
              <Button Style="{StaticResource AccentButton}" Content="Accept" Command="{Binding Accept}" />
            </StackPanel>
          </StackPanel>
        </ContentControl>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
