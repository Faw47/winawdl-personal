<UserControl x:Class="Winawdl.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Winawdl.Theme"
             xmlns:v="clr-namespace:Winawdl.Views"
             Focusable="False" Foreground="{DynamicResource Ink}"
             FontFamily="{StaticResource FontText}" FontSize="14"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />

    <!-- Out of its window, a card says which app it is from. -->
    <DataTemplate x:Key="Whose">
      <StackPanel Orientation="Horizontal">
        <t:DecorativeImage Width="16" Height="16" Margin="0,0,8,0" Source="{x:Static v:RequestsView.Mark}" />
        <TextBlock Style="{StaticResource Soft}" Text="winawdl" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The window around the cards is clear: the margin is where their shadows fall.
       What wants an answer sits lowest, nearest the corner. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <StackPanel Margin="20,20,20,10">
    <ItemsControl ItemsSource="{Binding Arrivals}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <!-- The whole card is the press: it leads to what arrived. -->
          <Button Style="{StaticResource PlateButton}" Width="340" Margin="0,0,0,10" Padding="16"
                  Tag="arrive" Loaded="OnArrived" Command="{Binding Press}"
                  AutomationProperties.Name="{Binding PressName}">
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="0,-10,-10,-10"
                        t:Plate.Glyph="&#xE711;" Command="{Binding Dismiss}" ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Whose}"
                                  VerticalAlignment="Center" />
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Template="{StaticResource FileFace}" Focusable="False"
                                DataContext="{Binding File}" Width="44" Height="44" Margin="0,0,14,0"
                                VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                  <t:LiveText Style="{StaticResource Name}" TextWrapping="Wrap" TextTrimming="None"
                             Text="{Binding Headline}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Style="{StaticResource Figures}" Margin="0,3,0,0" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button AutomationProperties.Name="Show in Folder" Style="{StaticResource TextButton}" Content="Show in Folder" Margin="0,0,6,0"
                        VerticalAlignment="Center" Command="{Binding Reveal}"
                        Visibility="{Binding Single, Converter={StaticResource Shown}}" />
                <Button AutomationProperties.Name="{Binding PressLabel}" Style="{StaticResource RaisedButton}" Content="{Binding PressLabel}"
                        Command="{Binding Press}" />
              </StackPanel>
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ItemsControl ItemsSource="{Binding Incoming}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ContentControl Style="{StaticResource RaisedCard}" Width="340" Margin="0,0,0,10" Tag="arrive"
                          Loaded="OnArrived"
                          Visibility="{Binding IsAsking, Converter={StaticResource Shown}}">
            <StackPanel>
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Whose}"
                                Margin="0,0,0,10" />
              <t:LiveText Style="{StaticResource Name}" TextWrapping="Wrap" TextTrimming="None"
                         Text="{Binding Headline}" AutomationProperties.LiveSetting="Assertive" />
              <t:LiveText AutomationProperties.LiveSetting="Polite" Style="{StaticResource Figures}" Margin="0,3,0,0" Text="{Binding Status}" />
              <UniformGrid Columns="2" Margin="0,14,0,0">
                <Button AutomationProperties.Name="Decline" Style="{StaticResource RaisedButton}" Content="Decline" Margin="0,0,5,0"
                        Command="{Binding Decline}" />
                <Button AutomationProperties.Name="Accept" Style="{StaticResource AccentButton}" Content="Accept" Margin="5,0,0,0"
                        Command="{Binding Accept}" />
              </UniformGrid>
            </StackPanel>
          </ContentControl>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
  </ScrollViewer>
</UserControl>
