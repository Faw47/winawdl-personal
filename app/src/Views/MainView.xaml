<UserControl x:Class="Winawdl.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Winawdl.Theme"
             x:Name="Root" Focusable="False" AllowDrop="True"
             Background="{DynamicResource Table}" Foreground="{DynamicResource Ink}"
             FontFamily="{StaticResource FontText}" FontSize="14"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Shown" />

    <!-- A file as a picture of itself: its thumbnail when Windows has one,
         the glyph of its kind on a fill when not. -->
    <ControlTemplate x:Key="Thumb" TargetType="ContentControl">
      <Grid>
        <Border CornerRadius="8" Background="{DynamicResource Well}" />
        <TextBlock Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource InkSoft}"
                   Text="{Binding Glyph}" />
        <t:RoundClip Radius="8">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
        </t:RoundClip>
        <Border CornerRadius="8" BorderBrush="{DynamicResource Outline}" BorderThickness="1" />
      </Grid>
    </ControlTemplate>

    <!-- The small round button that takes one file back out of the hand. -->
    <Style x:Key="RemoveButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPlate}" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse Fill="{DynamicResource InkSoft}" Stroke="{DynamicResource Raised}" StrokeThickness="1.5" />
              <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="8"
                         Foreground="{DynamicResource Raised}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Opacity" Value="1" />
        </Trigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+V" Command="{Binding Paste}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ChooseFiles}" />
  </UserControl.InputBindings>

  <Grid>
    <!-- While the settings cover it, nothing on the table can be reached. -->
    <Grid x:Name="TableSide" IsEnabled="{Binding TableInReach}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The window's name, who can find this PC, and the settings. -->
      <Grid Margin="24,12,16,0" MaxWidth="600">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource LargeTitle}" Text="AirDrop" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding Presence}" TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="FindMe" Style="{StaticResource Pill}" Click="OnFindMe"
                  AutomationProperties.Name="{Binding FindMeName}" ToolTip="Who can find this PC">
            <TextBlock Text="{Binding FindMeLabel}" />
            <Button.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem Header="Receiving Off" IsCheckable="False" IsChecked="{Binding FindMeOff, Mode=OneWay}"
                          Command="{Binding TurnOff}" />
                <Separator />
                <MenuItem Header="Contacts Only" IsChecked="{Binding FindMeContacts, Mode=OneWay}"
                          Command="{Binding FindByContacts}" />
                <MenuItem Header="Everyone for 10 Minutes" IsChecked="{Binding FindMeForAWhile, Mode=OneWay}"
                          Command="{Binding FindByEveryoneForAWhile}" />
                <MenuItem Header="Everyone" IsChecked="{Binding FindMeEveryone, Mode=OneWay}"
                          Command="{Binding FindByEveryone}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" t:Plate.Glyph="&#xE713;"
                  Margin="8,0,0,0" Command="{Binding OpenSettings}" ToolTip="Settings"
                  AutomationProperties.Name="Settings" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False">
        <StackPanel Margin="24,20,24,16" MaxWidth="600">
          <!-- What devices want to send, as an alert: who, what, and the two answers. -->
          <ItemsControl ItemsSource="{Binding Incoming}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Style="{StaticResource Card}" Margin="0,0,0,12" Tag="arrive" Loaded="OnArrived">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Margin="3" Fill="{DynamicResource Avatar}" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource InkSoft}"
                                   Text="{Binding Glyph}" />
                        <t:Ring Thickness="3" Stroke="{DynamicResource Accent}" Track="{DynamicResource Outline}"
                                Progress="{Binding Progress}" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Name}" TextWrapping="Wrap" TextTrimming="None"
                                   MaxHeight="40" Text="{Binding Headline}" />
                        <TextBlock Style="{StaticResource Figures}" Margin="0,2,0,0" Text="{Binding Status}" />
                      </StackPanel>
                    </Grid>
                    <UniformGrid Columns="2" Margin="0,16,0,0"
                                 Visibility="{Binding IsAsking, Converter={StaticResource Shown}}">
                      <Button Style="{StaticResource RaisedButton}" Content="Decline" Margin="0,0,5,0"
                              Command="{Binding Decline}" />
                      <Button Style="{StaticResource AccentButton}" Content="Accept" Margin="5,0,0,0"
                              Command="{Binding Accept}" />
                    </UniformGrid>
                    <Button Style="{StaticResource TextButton}" HorizontalAlignment="Center" Margin="0,8,0,-6"
                            Command="{Binding Always}" AutomationProperties.Name="{Binding AlwaysLabel}"
                            Visibility="{Binding ShowsAlways, Converter={StaticResource Shown}}">
                      <TextBlock Text="{Binding AlwaysLabel}" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Style="{StaticResource RaisedButton}" Content="Dismiss" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch" Command="{Binding Dismiss}"
                            Visibility="{Binding IsLost, Converter={StaticResource Shown}}" />
                  </StackPanel>
                </ContentControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- When there is nothing to see across the table: why, and the one thing to do. -->
          <StackPanel Margin="0,28,0,0" MaxWidth="340" HorizontalAlignment="Center"
                      Visibility="{Binding ShowsPanel, Converter={StaticResource Shown}}">
            <Grid Width="72" Height="72" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource Avatar}" />
              <TextBlock Style="{StaticResource Glyph}" FontSize="30" Foreground="{DynamicResource InkSoft}"
                         Text="&#xE701;" />
            </Grid>
            <TextBlock Style="{StaticResource Title}" Margin="0,16,0,0" TextAlignment="Center"
                       Text="{Binding PanelTitle}" />
            <TextBlock Style="{StaticResource Soft}" FontSize="14" LineHeight="20" Margin="0,6,0,0"
                       TextAlignment="Center" Text="{Binding PanelBody}" />
            <Button Style="{StaticResource AccentButton}" Command="{Binding PanelAction}" Margin="0,20,0,0"
                    HorizontalAlignment="Center" AutomationProperties.Name="{Binding PanelActionLabel}"
                    Visibility="{Binding PanelHasAction, Converter={StaticResource Shown}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE83D;" Margin="0,1,8,0" FontSize="14"
                           Foreground="{DynamicResource OnAccent}"
                           Visibility="{Binding PanelAsksWindows, Converter={StaticResource Shown}}" />
                <TextBlock Text="{Binding PanelActionLabel}" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource TextButton}" Content="Open the logs" Margin="0,8,0,0"
                    HorizontalAlignment="Center" Command="{Binding OpenLog}"
                    Visibility="{Binding PanelHasLog, Converter={StaticResource Shown}}" />
          </StackPanel>

          <!-- Devices nearby, as faces. Press one to send what is in hand, or drop files on it. -->
          <StackPanel Visibility="{Binding ShowsNearby, Converter={StaticResource Shown}}">
            <ItemsControl ItemsSource="{Binding Peers}" Focusable="False" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource DeviceTile}" Margin="6,0,6,18" Tag="arrive" Loaded="OnArrived"
                          AllowDrop="True" Drop="OnDropOnPeer" DragOver="OnDragOverPeer"
                          Command="{Binding Press}" t:Plate.Progress="{Binding Progress}"
                          t:Plate.Glyph="{Binding Glyph}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Width="104">
                      <TextBlock Style="{StaticResource Body}" FontSize="13" LineHeight="17" FontWeight="SemiBold"
                                 TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock TextAlignment="Center" Margin="0,2,0,0" Text="{Binding Status}"
                                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ember}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSent}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Button Style="{StaticResource TextButton}" Content="Stop" FontSize="12" Padding="8,2"
                              Margin="0,2,0,0" HorizontalAlignment="Center" Command="{Binding Stop}"
                              AutomationProperties.Name="{Binding StopName}"
                              Visibility="{Binding IsBusy, Converter={StaticResource Shown}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,28,0,0" MaxWidth="320" HorizontalAlignment="Center"
                        Visibility="{Binding ShowsNobody, Converter={StaticResource Shown}}">
              <Grid Width="96" Height="96" HorizontalAlignment="Center">
                <Ellipse Stroke="{DynamicResource Outline}" StrokeThickness="1" />
                <Ellipse Margin="16" Stroke="{DynamicResource Outline}" StrokeThickness="1" />
                <Ellipse Margin="32" Fill="{DynamicResource Accent}" />
              </Grid>
              <TextBlock Style="{StaticResource Name}" Margin="0,16,0,0" HorizontalAlignment="Center"
                         Text="{Binding NobodyTitle}" />
              <TextBlock Style="{StaticResource Soft}" Margin="0,6,0,0" TextAlignment="Center"
                         Text="{Binding NobodyBody}" />
            </StackPanel>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Notices}" Focusable="False" Margin="0,8,0,0" MaxWidth="400"
                        HorizontalAlignment="Center">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Style="{StaticResource Soft}" TextAlignment="Center" Margin="0,6,0,0" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- This side: what has arrived, and what is in hand to send. -->
      <StackPanel Grid.Row="2" Margin="24,0,24,24" MaxWidth="600">
        <StackPanel Margin="0,0,0,16" Visibility="{Binding HasReceived, Converter={StaticResource Shown}}">
          <DockPanel Margin="0,0,-8,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Show in Folder"
                    Command="{Binding OpenFolder}" />
            <TextBlock Style="{StaticResource Label}" Text="Recent" VerticalAlignment="Center" />
          </DockPanel>
          <ContentControl Style="{StaticResource Card}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="152" Focusable="False">
              <ItemsControl ItemsSource="{Binding Received}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource Row}" Tag="drop" Loaded="OnArrived" Command="{Binding Press}"
                            ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Name}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open" Command="{Binding Press}" />
                          <MenuItem Header="Play the Video" Command="{Binding PlayVideo}"
                                    Visibility="{Binding HasVideo, Converter={StaticResource Shown}}" />
                          <MenuItem Header="Show in Folder" Command="{Binding Reveal}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Template="{StaticResource Thumb}" Focusable="False" Width="36" Height="36"
                                        Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource Body}" TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                          <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </ContentControl>
        </StackPanel>

        <!-- The hand: drop files here, or choose them; then press a device above. -->
        <Grid x:Name="Hand" MinHeight="112">
          <Rectangle x:Name="HandFill" RadiusX="12" RadiusY="12" Fill="{DynamicResource AccentSoft}" Opacity="0" />
          <Rectangle x:Name="HandEdge" RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5 4"
                     Stroke="{DynamicResource InkSoft}" Opacity="0.55" />
          <StackPanel VerticalAlignment="Center" Margin="16,18"
                      Visibility="{Binding HoldsNothing, Converter={StaticResource Shown}}">
            <TextBlock x:Name="HandTitle" Style="{StaticResource Name}" Text="Drop files here to share"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
              <Button Content="Choose Files…" Command="{Binding ChooseFiles}">
                <Button.Style>
                  <!-- The accent only while choosing files is the next thing to do. -->
                  <Style TargetType="Button" BasedOn="{StaticResource RaisedButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ChooseIsNext}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Accent}" />
                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </StackPanel>
            <TextBox Style="{StaticResource Field}" MaxLength="8192" Margin="0,12,0,0" MaxWidth="320"
                     Tag="Or paste a web link"
                     Text="{Binding LinkDraft, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Web link to send" />
          </StackPanel>

          <StackPanel Margin="14,14,12,12" Visibility="{Binding HasHeld, Converter={StaticResource Shown}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
              <ItemsControl ItemsSource="{Binding Held}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="60" Height="60" Margin="0,0,8,0" Background="Transparent" Tag="drop"
                          Loaded="OnArrived" ToolTip="{Binding Name}">
                      <ContentControl Template="{StaticResource Thumb}" Focusable="False" Width="52" Height="52"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                      <Button Style="{StaticResource RemoveButton}" HorizontalAlignment="Right"
                              VerticalAlignment="Top" Command="{Binding Remove}" ToolTip="Remove"
                              AutomationProperties.Name="{Binding RemoveName}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <DockPanel Margin="0,10,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TextButton}" Content="Add" Command="{Binding ChooseFiles}"
                        AutomationProperties.Name="Add files" />
                <Button Style="{StaticResource TextButton}" Content="Clear" Command="{Binding ClearHeld}"
                        AutomationProperties.Name="Clear the files" />
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding HeldSummary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Caption}" Text="{Binding HeldHint}" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource Soft}" Foreground="{DynamicResource Ember}" Margin="4,8,4,0"
                   Text="{Binding HeldNotice}"
                   Visibility="{Binding HasHeldNotice, Converter={StaticResource Shown}}" />
      </StackPanel>
    </Grid>

    <!-- Settings slide over the table from the right. -->
    <Grid x:Name="Sheet" Visibility="{Binding SettingsOpen, Converter={StaticResource Shown}}">
      <Rectangle Fill="{DynamicResource Veil}" MouseLeftButtonDown="OnVeilPressed" />
      <Border x:Name="SheetPanel" HorizontalAlignment="Right" Width="344"
              Background="{DynamicResource Table}" BorderBrush="{DynamicResource Line}"
              BorderThickness="1,0,0,0" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border.InputBindings>
          <KeyBinding Key="Escape" Command="{Binding CloseSettings}" />
        </Border.InputBindings>
        <!-- Rows, so that Tab meets things in the order they are read. -->
        <Grid Margin="22,10,14,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Button x:Name="CloseSheet" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                    t:Plate.Glyph="&#xE711;" Command="{Binding CloseSettings}" ToolTip="Close (Esc)"
                    AutomationProperties.Name="Close settings" />
            <TextBlock Style="{StaticResource Title}" Text="Settings" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,14,0,10">
            <StackPanel Margin="0,0,8,0">
              <TextBlock Style="{StaticResource Label}" Text="Name other devices see" Margin="0,0,0,6" />
              <TextBox x:Name="NameBox" Style="{StaticResource Field}" MaxLength="63"
                       Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                       LostKeyboardFocus="OnNameLeft" KeyDown="OnNameKey"
                       AutomationProperties.Name="Name other devices see" />
              <TextBlock Style="{StaticResource Soft}" Foreground="{DynamicResource Ember}" Margin="0,6,0,0"
                         Text="{Binding NameError}"
                         Visibility="{Binding HasNameError, Converter={StaticResource Shown}}" />

              <TextBlock Style="{StaticResource Label}" Text="Received files go to" Margin="0,22,0,4" />
              <TextBlock Style="{StaticResource Body}" Text="{Binding Folder}" />
              <Button Style="{StaticResource RaisedButton}" Content="Change folder" Margin="0,10,0,0"
                      HorizontalAlignment="Left" Command="{Binding ChangeFolder}" />
              <TextBlock Style="{StaticResource Soft}" Foreground="{DynamicResource Ember}" Margin="0,6,0,0"
                         Text="{Binding FolderError}"
                         Visibility="{Binding HasFolderError, Converter={StaticResource Shown}}" />

              <TextBlock Style="{StaticResource Label}" Text="When a device wants to send files"
                         Margin="0,22,0,2" />
              <!-- The two choices are one group by sharing this panel. -->
              <StackPanel>
                <RadioButton Style="{StaticResource Choice}" Content="Ask me first"
                             IsChecked="{Binding AskFirst}" />
                <RadioButton Style="{StaticResource Choice}" IsChecked="{Binding TakeAll}"
                             AutomationProperties.Name="Take everything">
                  <StackPanel>
                    <TextBlock Text="Take everything" />
                    <TextBlock Style="{StaticResource Soft}"
                               Text="Anyone in range can then put files in that folder." />
                  </StackPanel>
                </RadioButton>
              </StackPanel>

              <CheckBox Style="{StaticResource Tick}" Margin="0,22,0,0"
                        IsChecked="{Binding OriginalMedia}"
                        AutomationProperties.Name="Preserve original photo and video formats">
                <StackPanel>
                  <TextBlock Text="Preserve original photo and video formats" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Soft}"
                             Text="Request HEIC and HEVC instead of converted files. Some devices may not support this." />
                </StackPanel>
              </CheckBox>

              <TextBlock Style="{StaticResource Label}" Text="Who can send to this PC" Margin="0,22,0,2" />
              <StackPanel>
                <RadioButton Style="{StaticResource Choice}" Content="Everyone"
                             IsChecked="{Binding AnyoneCanSend}" />
                <RadioButton Style="{StaticResource Choice}" IsChecked="{Binding EveryoneForAWhile}"
                             AutomationProperties.Name="Everyone for 10 minutes">
                  <StackPanel>
                    <TextBlock Text="Everyone for 10 minutes" />
                    <TextBlock Style="{StaticResource Soft}" Text="{Binding EveryoneUntil}" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource Choice}" IsChecked="{Binding OnlyKnownSenders}"
                             AutomationProperties.Name="Only the people listed here">
                  <StackPanel>
                    <TextBlock Text="Only the people listed here" />
                    <TextBlock Style="{StaticResource Soft}"
                               Text="Apple confirms who each sender is. Others cannot send, and most do not see this PC." />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding KnownSenders}" Focusable="False" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,2,-4,0">
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                              t:Plate.Glyph="&#xE711;" Command="{Binding Forget}"
                              ToolTip="Remove" AutomationProperties.Name="{Binding ForgetName}" />
                      <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Address}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBox x:Name="SenderBox" Style="{StaticResource Field}" Margin="0,8,0,0" MaxLength="254"
                       Text="{Binding SenderDraft, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSenderKey"
                       AutomationProperties.Name="Add someone by Apple ID email or phone number" />
              <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource RaisedButton}" Content="Add"
                        Command="{Binding AddSender}" />
                <TextBlock Style="{StaticResource Soft}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Text="An Apple ID email address or phone number." />
              </DockPanel>
              <TextBlock Style="{StaticResource Soft}" Foreground="{DynamicResource Ember}" Margin="0,6,0,0"
                         Text="{Binding SenderError}"
                         Visibility="{Binding HasSenderError, Converter={StaticResource Shown}}" />
              <TextBlock Style="{StaticResource Soft}" Foreground="{DynamicResource Ember}" Margin="0,6,0,0"
                         Text="Nobody is listed, so nobody can send."
                         Visibility="{Binding NobodyCanSend, Converter={StaticResource Shown}}" />

              <StackPanel Visibility="{Binding HasTrusted, Converter={StaticResource Shown}}">
                <TextBlock Style="{StaticResource Label}" Text="Inactive saved names" Margin="0,22,0,2" />
                <ItemsControl ItemsSource="{Binding Trusted}" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2,-4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                t:Plate.Glyph="&#xE711;" Command="{Binding Forget}"
                                ToolTip="Forget saved name" AutomationProperties.Name="{Binding ForgetName}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Margin="0,0,10,0"
                                   Foreground="{DynamicResource InkSoft}" Text="{Binding Glyph}" />
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Soft}" Margin="0,6,0,0"
                           Text="A device is known by the name and model it gives. Another device giving the same would be accepted too." />
              </StackPanel>

              <CheckBox Style="{StaticResource Tick}" Margin="0,22,0,0" IsChecked="{Binding ShowRequests}"
                        AutomationProperties.Name="Show requests and arrivals on screen">
                <StackPanel>
                  <TextBlock Text="Show requests and arrivals on screen" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Soft}"
                             Text="As cards in the corner, while winawdl is not the window in front." />
                </StackPanel>
              </CheckBox>

              <CheckBox Style="{StaticResource Tick}" Margin="0,16,0,0" IsChecked="{Binding KeepInTray}"
                        AutomationProperties.Name="Keep receiving when the window is closed">
                <StackPanel>
                  <TextBlock Text="Keep receiving when the window is closed" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Soft}"
                             Text="winawdl stays in the notification area. Quit it from its icon there." />
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </ScrollViewer>
          <DockPanel Grid.Row="2" Margin="0,0,8,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Project page"
                    Margin="0,0,-8,0" Command="{Binding OpenProject}" />
            <TextBlock Style="{StaticResource Soft}" Text="{Binding Version}" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
