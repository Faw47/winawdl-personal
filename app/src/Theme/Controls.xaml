<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Winawdl.Theme">

  <!-- The typeface and the icons Windows itself is drawn with; see app/DESIGN.md. -->
  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Soft" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Soft}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A line with numbers that change while it is read. Gone when it says nothing. -->
  <Style x:Key="Figures" TargetType="TextBlock" BasedOn="{StaticResource Soft}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Name" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Keyboard focus: a ring in the accent, outside the thing it is on. -->
  <Style x:Key="FocusPlate">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="21" RadiusY="21" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusButton">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="13" RadiusY="13" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusField">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A device, or anything else hand sized that is pressed as a whole. -->
  <Style x:Key="PlateButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPlate}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <t:Raised x:Name="Surface" Radius="18" Fill="{DynamicResource Raised}"
                    Edge="{DynamicResource Edge}" Outline="{DynamicResource Outline}"
                    ShadowStrength="{DynamicResource ShadowStrength}">
            <Grid>
              <t:FillBar Radius="18" Tint="{DynamicResource AccentSoft}" Line="{DynamicResource Accent}"
                         Value="{Binding (t:Plate.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </t:Raised>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="IsHot" Value="True" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="IsDown" Value="True" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A file as a thing: its own picture when Windows has one, a glyph for its kind when not. -->
  <ControlTemplate x:Key="FileFace" TargetType="ContentControl">
    <t:Raised x:Name="Surface" Radius="8" Fill="{DynamicResource Raised}" Edge="{DynamicResource Edge}"
              Outline="{DynamicResource Outline}" ShadowStrength="{DynamicResource ShadowStrength}">
      <Grid>
        <TextBlock Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource InkSoft}"
                   Text="{Binding Glyph}" />
        <t:RoundClip Radius="8">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
        </t:RoundClip>
      </Grid>
    </t:Raised>
  </ControlTemplate>

  <!-- A raised surface that is not itself pressed: it holds text and buttons. -->
  <Style x:Key="RaisedCard" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <t:Raised Radius="18" Fill="{DynamicResource Raised}" Edge="{DynamicResource Edge}"
                    Outline="{DynamicResource Outline}" ShadowStrength="{DynamicResource ShadowStrength}">
            <Grid>
              <t:FillBar Radius="18" Tint="{DynamicResource AccentSoft}" Line="{DynamicResource Accent}"
                         Value="{Binding (t:Plate.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </t:Raised>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RaisedButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <t:Raised x:Name="Surface" Radius="10" Fill="{TemplateBinding Background}"
                    Edge="{DynamicResource Edge}" Outline="{DynamicResource Outline}"
                    ShadowStrength="{DynamicResource ShadowStrength}">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </t:Raised>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="IsHot" Value="True" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="IsDown" Value="True" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The one press on a screen that moves a file. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource RaisedButton}">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Back" CornerRadius="10" Background="Transparent">
            <TextBlock Text="{Binding (t:Plate.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                       Style="{StaticResource Glyph}" Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="t:Switch">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="4,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="t:Switch">
          <StackPanel Orientation="Horizontal" Background="Transparent" Margin="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0" />
            <Grid Width="44" Height="24">
              <Border CornerRadius="12" Background="{DynamicResource Well}"
                      BorderBrush="{DynamicResource InkSoft}" BorderThickness="1" />
              <Border x:Name="PART_On" CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0" />
              <Ellipse x:Name="PART_Thumb" Width="14" Height="14" Margin="5,0" HorizontalAlignment="Left"
                       Fill="{DynamicResource InkSoft}" />
            </Grid>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A field is a small well: what is typed lands in it. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <t:Well Radius="10" Fill="{DynamicResource Well}" Edge="{DynamicResource Edge}"
                  Outline="{DynamicResource Outline}" ShadeStrength="{DynamicResource ShadeStrength}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
          </t:Well>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Choice" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
              <Ellipse Fill="{DynamicResource Well}" Stroke="{DynamicResource InkSoft}" StrokeThickness="1" />
              <Ellipse x:Name="On" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Visibility" Value="Visible" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Tick" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
              <Border CornerRadius="5" Background="{DynamicResource Well}"
                      BorderBrush="{DynamicResource InkSoft}" BorderThickness="1" />
              <Border x:Name="On" CornerRadius="5" Background="{DynamicResource Accent}" Visibility="Collapsed">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12"
                           Foreground="{DynamicResource OnAccent}" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars thin enough to stay out of the way of what scrolls. -->
  <Style x:Key="ScrollGap" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollGrip" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="2" Background="{DynamicResource Scroll}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ScrollUpright" TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
      <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollGap}" />
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
        <Thumb Style="{StaticResource ScrollGrip}" Margin="3,2" />
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollGap}" />
      </Track.IncreaseRepeatButton>
    </Track>
  </ControlTemplate>
  <ControlTemplate x:Key="ScrollLevel" TargetType="ScrollBar">
    <Track x:Name="PART_Track" Height="10">
      <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollGap}" />
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
        <Thumb Style="{StaticResource ScrollGrip}" Margin="2,3" />
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollGap}" />
      </Track.IncreaseRepeatButton>
    </Track>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template" Value="{StaticResource ScrollUpright}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template" Value="{StaticResource ScrollLevel}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Margin="6" CornerRadius="8" Padding="9,6" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="8" CornerRadius="10" Padding="4" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Back" CornerRadius="6" Padding="12,8" MinWidth="170" Background="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
