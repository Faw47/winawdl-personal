<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Winawdl.Theme">

  <!-- The typeface and the icons Windows itself is drawn with; see app/DESIGN.md. -->
  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Soft" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Soft}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A line with numbers that change while it is read. Gone when it says nothing. -->
  <Style x:Key="Figures" TargetType="TextBlock" BasedOn="{StaticResource Soft}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Name" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The window's own name, once, at its top. -->
  <Style x:Key="LargeTitle" TargetType="TextBlock" BasedOn="{StaticResource Title}">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Soft}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontIcons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Keyboard focus: a ring in the accent, outside the thing it is on. -->
  <Style x:Key="FocusPlate">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="21" RadiusY="21" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusButton">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="11" RadiusY="11" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusField">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2"
                     Stroke="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A device, or anything else hand sized that is pressed as a whole. -->
  <Style x:Key="PlateButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusPlate}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <t:Raised x:Name="Surface" Radius="18" Fill="{DynamicResource Raised}"
                    Edge="{DynamicResource Edge}" Outline="{DynamicResource Outline}"
                    ShadowStrength="{DynamicResource ShadowStrength}">
            <Grid>
              <t:FillBar Radius="18" Tint="{DynamicResource AccentSoft}" Line="{DynamicResource Accent}"
                         Value="{Binding (t:Plate.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </t:Raised>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="IsHot" Value="True" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="IsDown" Value="True" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A file as a thing: its own picture when Windows has one, a glyph for its kind when not. -->
  <ControlTemplate x:Key="FileFace" TargetType="ContentControl">
    <Grid>
      <Border CornerRadius="8" Background="{DynamicResource Well}" />
      <TextBlock Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource InkSoft}"
                 Text="{Binding Glyph}" />
      <t:RoundClip Radius="8">
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
      </t:RoundClip>
      <Border CornerRadius="8" BorderBrush="{DynamicResource Outline}" BorderThickness="1" />
    </Grid>
  </ControlTemplate>

  <!-- A raised surface that is not itself pressed: it holds text and buttons. -->
  <Style x:Key="RaisedCard" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <t:Raised Radius="18" Fill="{DynamicResource Raised}" Edge="{DynamicResource Edge}"
                    Outline="{DynamicResource Outline}" ShadowStrength="{DynamicResource ShadowStrength}">
            <Grid>
              <t:FillBar Radius="18" Tint="{DynamicResource AccentSoft}" Line="{DynamicResource Accent}"
                         Value="{Binding (t:Plate.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </t:Raised>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RaisedButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Well}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border CornerRadius="8" Background="{TemplateBinding Background}" />
            <Border x:Name="Over" CornerRadius="8" Background="{DynamicResource Hover}" Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Over" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Over" Property="Opacity" Value="2.2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The one press on a screen that moves a file. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource RaisedButton}">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>

  <Style x:Key="TextButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource InkSoft}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Back" CornerRadius="8" Background="Transparent">
            <TextBlock Text="{Binding (t:Plate.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                       Style="{StaticResource Glyph}" Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An on/off switch as iOS draws one: the label on the left, the switch on
       the right, the track filled with the accent when on. -->
  <Style TargetType="t:Switch">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="t:Switch">
          <DockPanel Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid DockPanel.Dock="Right" Width="44" Height="24" Margin="12,0,0,0" VerticalAlignment="Center">
              <Border CornerRadius="12" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Outline}"
                      BorderThickness="1" />
              <Border x:Name="PART_On" CornerRadius="12" Background="{DynamicResource Accent}" Opacity="0" />
              <Ellipse x:Name="PART_Thumb" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left"
                       Fill="{DynamicResource InkSoft}">
                <Ellipse.Effect>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" />
                </Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A field is a small well: what is typed lands in it. -->
  <Style x:Key="Field" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" CornerRadius="8" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Grid>
              <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                         Style="{StaticResource Soft}" FontSize="14" VerticalAlignment="Center"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="{TemplateBinding Tag}" Visibility="Collapsed" IsHitTestVisible="False" />
              <!-- No margin here: the text view applies the box's Padding itself. -->
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <!-- A field says what it is for while it is empty, in its Tag. -->
            <Trigger Property="Text" Value="">
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Choice" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
              <Ellipse Fill="{DynamicResource Raised}" Stroke="{DynamicResource InkSoft}" StrokeThickness="1" />
              <Ellipse x:Name="On" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
              <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource OnAccent}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Visibility" Value="Visible" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Tick" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
              <Border CornerRadius="5" Background="{DynamicResource Raised}"
                      BorderBrush="{DynamicResource InkSoft}" BorderThickness="1" />
              <Border x:Name="On" CornerRadius="5" Background="{DynamicResource Accent}" Visibility="Collapsed">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12"
                           Foreground="{DynamicResource OnAccent}" />
              </Border>
            </Grid>
            <ContentPresenter Grid.Column="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="On" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars thin enough to stay out of the way of what scrolls. -->
  <Style x:Key="ScrollGap" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollGrip" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="2" Background="{DynamicResource Scroll}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="ScrollUpright" TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
      <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollGap}" />
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
        <Thumb Style="{StaticResource ScrollGrip}" Margin="3,2" />
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollGap}" />
      </Track.IncreaseRepeatButton>
    </Track>
  </ControlTemplate>
  <ControlTemplate x:Key="ScrollLevel" TargetType="ScrollBar">
    <Track x:Name="PART_Track" Height="10">
      <Track.DecreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollGap}" />
      </Track.DecreaseRepeatButton>
      <Track.Thumb>
        <Thumb Style="{StaticResource ScrollGrip}" Margin="2,3" />
      </Track.Thumb>
      <Track.IncreaseRepeatButton>
        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollGap}" />
      </Track.IncreaseRepeatButton>
    </Track>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template" Value="{StaticResource ScrollUpright}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template" Value="{StaticResource ScrollLevel}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Margin="6" CornerRadius="8" Padding="9,6" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- A flat surface on the window: a card holds text and buttons. -->
  <Style x:Key="Card" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border CornerRadius="12" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Outline}"
                  BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A pill that opens a menu: what it says is the choice now, the chevron
       that there are others. -->
  <Style x:Key="Pill" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusButton}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="12,0,10,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border CornerRadius="14" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Outline}"
                    BorderThickness="1" />
            <Border x:Name="Over" CornerRadius="14" Background="{DynamicResource Hover}" Opacity="0" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
              <ContentPresenter VerticalAlignment="Center" />
              <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9" Margin="7,1,0,0"
                         Foreground="{DynamicResource InkSoft}" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Over" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A device nearby, as AirDrop shows it: a round face, its name under it
       and one short line of what is happening. The ring around the face is
       how far a transfer has got. -->
  <Style x:Key="DeviceTile" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Width" Value="104" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <StackPanel Background="Transparent">
            <Grid Width="76" Height="76" HorizontalAlignment="Center">
              <Ellipse x:Name="Focus" Margin="-4" Stroke="{DynamicResource AccentText}" StrokeThickness="2"
                       Visibility="Collapsed" />
              <Ellipse x:Name="Face" Margin="6" Fill="{DynamicResource Avatar}" RenderTransformOrigin="0.5,0.5" />
              <TextBlock Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource InkSoft}"
                         Text="{Binding (t:Plate.Glyph), RelativeSource={RelativeSource TemplatedParent}}" />
              <t:Ring Thickness="3" Stroke="{DynamicResource Accent}" Track="{DynamicResource Outline}"
                      Progress="{Binding (t:Plate.Progress), RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
            <ContentPresenter Margin="0,8,0,0" HorizontalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row in a list: the whole row is pressed, and it lights on hover. -->
  <Style x:Key="Row" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusField}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Back" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus as the rest of the window draws: a rounded card, quiet rows, a
       check for the choice in force. The system's own looks a decade older. -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="0,0,10,12" CornerRadius="10" Background="{DynamicResource Raised}"
                  BorderBrush="{DynamicResource Outline}" BorderThickness="1" Padding="5" MinWidth="200">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270" Opacity="0.22"
                                Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="8,6,14,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12"
                         HorizontalAlignment="Left" Visibility="Hidden" Foreground="{TemplateBinding Foreground}" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,5" Background="{DynamicResource Outline}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
