index 0000000..5586482
--- /dev/null
+++ b/src/PcieTransportVfio.cpp
@@ -0,0 +1,332 @@
+#include "PcieTransport.h"
+
+/* Linux host backend: vfio-pci. Compiled when DEVOURER_PCIE=ON on Linux. */
+
+#include <cerrno>
+#include <cstring>
+
+#include <fcntl.h>
+#include <linux/vfio.h>
+#include <sys/eventfd.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace devourer {
+
+namespace {
+constexpr uint16_t kPciDidRtl8852ce = 0xC852;
+} /* namespace */
+
+struct PcieTransport::Os {
+  int container = -1, group = -1, device = -1;
+  int msi_evt = -1; /* eventfd signalled per MSI; -1 = polling mode */
+  volatile uint8_t *mmio = nullptr;
+  uint64_t cfg_region_off = 0;
+  size_t cfg_region_len = 0;
+  uint8_t *slab = nullptr; /* DMA slab VA (anonymous, VFIO-pinned) */
+  size_t slab_len = 0;
+};
+
+PcieTransport::PcieTransport(Logger_t logger, Config cfg)
+    : _logger(std::move(logger)), _cfg(cfg), _os(std::make_unique<Os>()) {}
+
+int PcieTransport::msi_fd() const { return _os->msi_evt; }
+
+bool PcieTransport::setup_msi() {
+  struct vfio_irq_info info{};
+  info.argsz = sizeof(info);
+  info.index = VFIO_PCI_MSI_IRQ_INDEX;
+  if (ioctl(_os->device, VFIO_DEVICE_GET_IRQ_INFO, &info) < 0 ||
+      info.count < 1) {
+    _logger->warn("PcieTransport: no MSI IRQ available");
+    return false;
+  }
+  int evt = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+  if (evt < 0)
+    return false;
+  /* One MSI vector -> the eventfd. */
+  char buf[sizeof(struct vfio_irq_set) + sizeof(int32_t)] = {};
+  auto *is = reinterpret_cast<struct vfio_irq_set *>(buf);
+  is->argsz = sizeof(buf);
+  is->flags = VFIO_IRQ_SET_DATA_EVENTFD | VFIO_IRQ_SET_ACTION_TRIGGER;
+  is->index = VFIO_PCI_MSI_IRQ_INDEX;
+  is->start = 0;
+  is->count = 1;
+  memcpy(is->data, &evt, sizeof(int32_t));
+  if (ioctl(_os->device, VFIO_DEVICE_SET_IRQS, is) < 0) {
+    _logger->warn("PcieTransport: VFIO_DEVICE_SET_IRQS(MSI) failed: {}",
+                  strerror(errno));
+    close(evt);
+    return false;
+  }
+  _os->msi_evt = evt;
+  return true;
+}
+
+PcieTransport::~PcieTransport() {
+  if (_os->msi_evt >= 0) {
+    if (_os->mmio && _dma)
+      _dma->irq_mask(); /* mask before dropping the vector */
+    struct vfio_irq_set off{};
+    off.argsz = sizeof(off);
+    off.flags = VFIO_IRQ_SET_DATA_NONE | VFIO_IRQ_SET_ACTION_TRIGGER;
+    off.index = VFIO_PCI_MSI_IRQ_INDEX;
+    off.count = 0;
+    ioctl(_os->device, VFIO_DEVICE_SET_IRQS, &off);
+    close(_os->msi_evt);
+  }
+  _dma.reset();
+  if (_os->mmio)
+    munmap(const_cast<uint8_t *>(_os->mmio), _mmio_len);
+  if (_os->slab && _os->container >= 0) {
+    struct vfio_iommu_type1_dma_unmap um{};
+    um.argsz = sizeof(um);
+    um.iova = _cfg.iova_base;
+    um.size = _os->slab_len;
+    ioctl(_os->container, VFIO_IOMMU_UNMAP_DMA, &um);
+  }
+  if (_os->slab)
+    munmap(_os->slab, _os->slab_len);
+  if (_os->device >= 0)
+    close(_os->device);
+  if (_os->group >= 0)
+    close(_os->group);
+  if (_os->container >= 0)
+    close(_os->container);
+}
+
+bool PcieTransport::open_device(const std::string &bdf) {
+  /* IOMMU group number from sysfs. */
+  std::string link = "/sys/bus/pci/devices/" + bdf + "/iommu_group";
+  char buf[256];
+  ssize_t n = readlink(link.c_str(), buf, sizeof(buf) - 1);
+  if (n <= 0) {
+    _logger->error("PcieTransport: readlink({}) failed: {}", link,
+                   strerror(errno));
+    return false;
+  }
+  buf[n] = 0;
+  const char *slash = strrchr(buf, '/');
+  std::string group_num = slash ? slash + 1 : buf;
+
+  _os->container = open("/dev/vfio/vfio", O_RDWR);
+  if (_os->container < 0) {
+    _logger->error("PcieTransport: open /dev/vfio/vfio failed: {} (modprobe "
+                   "vfio-pci?)",
+                   strerror(errno));
+    return false;
+  }
+  if (ioctl(_os->container, VFIO_GET_API_VERSION) != VFIO_API_VERSION) {
+    _logger->error("PcieTransport: VFIO API version mismatch");
+    return false;
+  }
+  int iommu_type = 0;
+  if (ioctl(_os->container, VFIO_CHECK_EXTENSION, VFIO_TYPE1v2_IOMMU) == 1)
+    iommu_type = VFIO_TYPE1v2_IOMMU;
+  else if (ioctl(_os->container, VFIO_CHECK_EXTENSION, VFIO_TYPE1_IOMMU) == 1)
+    iommu_type = VFIO_TYPE1_IOMMU;
+  else {
+    _logger->error("PcieTransport: no Type1 IOMMU support");
+    return false;
+  }
+
+  std::string group_path = "/dev/vfio/" + group_num;
+  _os->group = open(group_path.c_str(), O_RDWR);
+  if (_os->group < 0) {
+    _logger->error("PcieTransport: open {} failed: {} (device bound to "
+                   "vfio-pci? permissions?)",
+                   group_path, strerror(errno));
+    return false;
+  }
+  struct vfio_group_status st{};
+  st.argsz = sizeof(st);
+  if (ioctl(_os->group, VFIO_GROUP_GET_STATUS, &st) < 0 ||
+      !(st.flags & VFIO_GROUP_FLAGS_VIABLE)) {
+    _logger->error("PcieTransport: IOMMU group {} not viable (all devices in "
+                   "the group must be bound to vfio-pci)",
+                   group_num);
+    return false;
+  }
+  if (ioctl(_os->group, VFIO_GROUP_SET_CONTAINER, &_os->container) < 0) {
+    _logger->error("PcieTransport: GROUP_SET_CONTAINER failed: {}",
+                   strerror(errno));
+    return false;
+  }
+  if (ioctl(_os->container, VFIO_SET_IOMMU, iommu_type) < 0) {
+    _logger->error("PcieTransport: SET_IOMMU failed: {}", strerror(errno));
+    return false;
+  }
+  _os->device = ioctl(_os->group, VFIO_GROUP_GET_DEVICE_FD, bdf.c_str());
+  if (_os->device < 0) {
+    _logger->error("PcieTransport: GET_DEVICE_FD({}) failed: {}", bdf,
+                   strerror(errno));
+    return false;
+  }
+  _logger->info("PcieTransport: vfio group {} opened for {}", group_num, bdf);
+
+  struct vfio_region_info reg{};
+  reg.argsz = sizeof(reg);
+  reg.index = VFIO_PCI_BAR2_REGION_INDEX;
+  if (ioctl(_os->device, VFIO_DEVICE_GET_REGION_INFO, &reg) < 0) {
+    _logger->error("PcieTransport: BAR2 region info failed: {}",
+                   strerror(errno));
+    return false;
+  }
+  if (!(reg.flags & VFIO_REGION_INFO_FLAG_MMAP) || reg.size == 0) {
+    _logger->error("PcieTransport: BAR2 not mmap-able (size={} flags={:#x})",
+                   (unsigned long long)reg.size, reg.flags);
+    return false;
+  }
+  void *p = mmap(nullptr, reg.size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                 _os->device, reg.offset);
+  if (p == MAP_FAILED) {
+    _logger->error("PcieTransport: BAR2 mmap failed: {}", strerror(errno));
+    return false;
+  }
+  _os->mmio = static_cast<volatile uint8_t *>(p);
+  _mmio_len = reg.size;
+  return true;
+}
+
+uint32_t PcieTransport::reg_read(uint32_t off, size_t width) {
+  volatile uint8_t *p = _os->mmio + off;
+  if (width == 4)
+    return *reinterpret_cast<volatile uint32_t *>(p);
+  if (width == 2)
+    return *reinterpret_cast<volatile uint16_t *>(p);
+  return *p;
+}
+
+void PcieTransport::reg_write(uint32_t off, size_t width, uint32_t v) {
+  volatile uint8_t *p = _os->mmio + off;
+  if (width == 4)
+    *reinterpret_cast<volatile uint32_t *>(p) = v;
+  else if (width == 2)
+    *reinterpret_cast<volatile uint16_t *>(p) = static_cast<uint16_t>(v);
+  else
+    *p = static_cast<uint8_t>(v);
+}
+
+bool PcieTransport::cfg_read(uint32_t off, void *buf, size_t len) {
+  return pread(_os->device, buf, len, _os->cfg_region_off + off) ==
+         static_cast<ssize_t>(len);
+}
+
+bool PcieTransport::cfg_write(uint32_t off, const void *buf, size_t len) {
+  return pwrite(_os->device, buf, len, _os->cfg_region_off + off) ==
+         static_cast<ssize_t>(len);
+}
+
+bool PcieTransport::setup_config_space() {
+  struct vfio_region_info reg{};
+  reg.argsz = sizeof(reg);
+  reg.index = VFIO_PCI_CONFIG_REGION_INDEX;
+  if (ioctl(_os->device, VFIO_DEVICE_GET_REGION_INFO, &reg) < 0) {
+    _logger->error("PcieTransport: config region info failed: {}",
+                   strerror(errno));
+    return false;
+  }
+  _os->cfg_region_off = reg.offset;
+  _os->cfg_region_len = reg.size;
+
+  uint16_t vid = 0, did = 0;
+  cfg_read(0x00, &vid, 2);
+  cfg_read(0x02, &did, 2);
+  if (vid == 0xFFFF) {
+    _logger->error("PcieTransport: config space reads 0xFFFF — link down?");
+    return false;
+  }
+  _pci_vid = vid;
+  _pci_did = did;
+  _logger->info("PcieTransport: PCI device {:04x}:{:04x}", vid, did);
+
+  /* Memory + bus-master enable. Without bus-master every register read works
+   * but no DMA moves — the classic silent-failure trap. */
+  uint16_t cmd = 0;
+  cfg_read(0x04, &cmd, 2);
+  cmd |= 0x2 /* MEMORY */ | 0x4 /* MASTER */;
+  cfg_write(0x04, &cmd, 2);
+
+  /* Find the PCI Express capability (id 0x10) for LNKCTL / DEVCTL2. */
+  uint8_t cap_ptr = 0;
+  cfg_read(0x34, &cap_ptr, 1);
+  uint32_t pcie_cap = 0;
+  for (int guard = 0; cap_ptr && guard < 48; guard++) {
+    uint8_t id = 0, next = 0;
+    cfg_read(cap_ptr, &id, 1);
+    cfg_read(cap_ptr + 1, &next, 1);
+    if (id == 0x10) {
+      pcie_cap = cap_ptr;
+      break;
+    }
+    cap_ptr = next;
+  }
+  _pcie_cap = pcie_cap;
+  if (pcie_cap) {
+    /* Clear ASPM (LNKCTL[1:0]) during bring-up — L1 entry on a half-configured
+     * link is a known hang source. */
+    uint16_t lnkctl = 0;
+    cfg_read(pcie_cap + 0x10, &lnkctl, 2);
+    if (lnkctl & 0x3) {
+      lnkctl &= ~0x3;
+      cfg_write(pcie_cap + 0x10, &lnkctl, 2);
+      _logger->info("PcieTransport: ASPM disabled for bring-up");
+    }
+    /* Disable completion timeout (DEVCTL2 bit4) — rtw88 does this specifically
+     * for the 8821C (rtw_pci_phy_cfg). Only there: with the timeout off, a
+     * read of a device that stops answering never completes and the CPU
+     * hangs in the MMIO load instead of seeing all-ones, so the AX parts
+     * (rtw89 leaves the timeout alone) keep it. */
+    if (_pci_did != kPciDidRtl8852ce) {
+      uint16_t devctl2 = 0;
+      cfg_read(pcie_cap + 0x28, &devctl2, 2);
+      devctl2 |= 1u << 4;
+      cfg_write(pcie_cap + 0x28, &devctl2, 2);
+    }
+  } else {
+    _logger->warn("PcieTransport: PCIe capability not found — skipping "
+                  "ASPM/completion-timeout config");
+  }
+  return true;
+}
+
+bool PcieTransport::init_dma() {
+  _os->slab_len = _dma->slab_bytes();
+  void *p = mmap(nullptr, _os->slab_len, PROT_READ | PROT_WRITE,
+                 MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+  if (p == MAP_FAILED) {
+    _logger->error("PcieTransport: DMA slab mmap({} KiB) failed: {}",
+                   _os->slab_len / 1024, strerror(errno));
+    return false;
+  }
+  _os->slab = static_cast<uint8_t *>(p);
+  memset(_os->slab, 0, _os->slab_len);
+
+  if (_cfg.iova_base + _os->slab_len > (1ull << 32)) {
+    _logger->error("PcieTransport: IOVA base 0x{:x} + slab exceeds 4 GiB (the "
+                   "descriptor dma fields are 32-bit)",
+                   _cfg.iova_base);
+    return false;
+  }
+  struct vfio_iommu_type1_dma_map m{};
+  m.argsz = sizeof(m);
+  m.flags = VFIO_DMA_MAP_FLAG_READ | VFIO_DMA_MAP_FLAG_WRITE;
+  m.vaddr = reinterpret_cast<uint64_t>(_os->slab);
+  m.iova = _cfg.iova_base;
+  m.size = _os->slab_len;
+  if (ioctl(_os->container, VFIO_IOMMU_MAP_DMA, &m) < 0) {
+    _logger->error("PcieTransport: VFIO_IOMMU_MAP_DMA failed: {}",
+                   strerror(errno));
+    return false;
+  }
+  /* One IOVA run for the whole slab; closing the device fd resets the
+   * function, so the plane's quiesce ops are not needed here. */
+  _slab.va = _os->slab;
+  _slab.len = _os->slab_len;
+  _slab.chunk_bytes = 0;
+  _slab.chunk_iova = {_cfg.iova_base};
+  return _dma->attach(_slab);
+}
+
+} /* namespace devourer */
diff --git a/src/PcieTransportWin.cpp b/src/PcieTransportWin.cpp
new file mode 100644
index 0000000..e449ec4
--- /dev/null
+++ b/src/PcieTransportWin.cpp
@@ -0,0 +1,337 @@
+#include "PcieTransport.h"
+
+/* Windows host backend. Compiled when DEVOURER_PCIE=ON on Windows.
+ *
+ * Registers go through a user-mode register proxy driver bound to the card
+ * (the winawdl project's regproxy; its IOCTL contract is regproxy_ioctl.h,
+ * found through DEVOURER_REGPROXY_INCLUDE_DIR). The DMA slab is AWE memory
+ * owned by this process: locked 2 MiB blocks whose physical addresses are
+ * handed to the chip as bus addresses. Nothing remaps or fences that DMA, so
+ * the proxy is given the plane's quiesce ops to replay if this process dies. */
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+#include <cfgmgr32.h>
+#include <setupapi.h>
+#include <winioctl.h>
+
+#include <algorithm>
+#include <cstring>
+#include <cwchar>
+#include <vector>
+
+#include "PhysicalBlocks.h"
+#include "regproxy_ioctl.h"
+
+namespace devourer {
+
+namespace {
+
+constexpr size_t kPageBytes = 4096;
+constexpr size_t kBlockBytes = size_t{2} << 20;
+constexpr size_t kPagesPerBlock = kBlockBytes / kPageBytes;
+constexpr unsigned kPageShift = 12;
+constexpr ULONG_PTR kFrameAt4GiB = ULONG_PTR{1} << (32 - kPageShift);
+/* The system hands out blocks wherever it likes: ask for more than needed
+ * and keep the lowest the DMA plane can address. The last attempt takes
+ * every free large page there is. */
+constexpr size_t kOverRequest[] = {4, 16};
+constexpr size_t kRequestEverything = 4096;
+
+using AllocatePages2Fn = BOOL(WINAPI *)(HANDLE, PULONG_PTR, PULONG_PTR,
+                                        PMEM_EXTENDED_PARAMETER, ULONG);
+
+bool enable_lock_memory_privilege() {
+  HANDLE token = nullptr;
+  if (!OpenProcessToken(GetCurrentProcess(),
+                        TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &token))
+    return false;
+  TOKEN_PRIVILEGES privileges{};
+  privileges.PrivilegeCount = 1;
+  privileges.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+  const bool found = LookupPrivilegeValueW(nullptr, L"SeLockMemoryPrivilege",
+                                           &privileges.Privileges[0].Luid);
+  if (found)
+    AdjustTokenPrivileges(token, FALSE, &privileges, 0, nullptr, nullptr);
+  /* AdjustTokenPrivileges succeeds even when the privilege is not held. */
+  const bool enabled = found && GetLastError() == ERROR_SUCCESS;
+  CloseHandle(token);
+  return enabled;
+}
+
+/* Allocates `count` locked 2 MiB blocks; each entry of the result is the
+ * frame number of a block's first 4 KiB page. May return fewer. */
+std::vector<ULONG_PTR> allocate_blocks(size_t count) {
+  /* Looked up at run time: the import library that carries it varies by SDK. */
+  const auto allocate = reinterpret_cast<AllocatePages2Fn>(GetProcAddress(
+      GetModuleHandleW(L"kernelbase.dll"), "AllocateUserPhysicalPages2"));
+  std::vector<ULONG_PTR> frames(count);
+  MEM_EXTENDED_PARAMETER large{};
+  large.Type = MemExtendedParameterAttributeFlags;
+  large.ULong64 = MEM_EXTENDED_PARAMETER_NONPAGED_LARGE;
+  ULONG_PTR got = count;
+  if (!allocate ||
+      !allocate(GetCurrentProcess(), &got, frames.data(), &large, 1))
+    got = 0;
+  frames.resize(got);
+  return frames;
+}
+
+void free_blocks(std::vector<ULONG_PTR> &frames) {
+  ULONG_PTR count = frames.size();
+  if (count)
+    FreeUserPhysicalPages(GetCurrentProcess(), &count, frames.data());
+  frames.clear();
+}
+
+/* "PCI\VEN_10EC&DEV_C852&..." -> the hex field after `key`. */
+uint16_t instance_id_field(const wchar_t *instance_id, const wchar_t *key) {
+  const wchar_t *at = std::wcsstr(instance_id, key);
+  return at ? static_cast<uint16_t>(
+                  std::wcstoul(at + std::wcslen(key), nullptr, 16))
+            : 0;
+}
+
+} /* namespace */
+
+struct PcieTransport::Os {
+  HANDLE proxy = INVALID_HANDLE_VALUE;
+  uint8_t *slab = nullptr;         /* one MEM_PHYSICAL view over all blocks */
+  std::vector<ULONG_PTR> blocks;   /* first frame of each mapped block */
+  std::vector<REGPROXY_OP> quiesce; /* stops the plane's DMA engine */
+  std::atomic<bool> io_error_logged{false};
+};
+
+PcieTransport::PcieTransport(Logger_t logger, Config cfg)
+    : _logger(std::move(logger)), _cfg(cfg), _os(std::make_unique<Os>()) {}
+
+PcieTransport::~PcieTransport() {
+  _dma.reset();
+  if (_os->proxy != INVALID_HANDLE_VALUE && !_os->quiesce.empty()) {
+    /* The device object stops DMA on its own teardown; repeating it here is
+     * what makes freeing the slab safe when that object never existed. */
+    DWORD returned = 0;
+    const DWORD bytes =
+        static_cast<DWORD>(_os->quiesce.size() * sizeof(REGPROXY_OP));
+    DeviceIoControl(_os->proxy, IOCTL_REGPROXY_BATCH, _os->quiesce.data(),
+                    bytes, _os->quiesce.data(), bytes, &returned, nullptr);
+    DeviceIoControl(_os->proxy, IOCTL_REGPROXY_SET_CLOSE_OPS, nullptr, 0,
+                    nullptr, 0, &returned, nullptr);
+  }
+  if (_os->slab) {
+    for (size_t i = 0; i < _os->blocks.size(); i++)
+      MapUserPhysicalPages(_os->slab + i * kBlockBytes, kPagesPerBlock,
+                           nullptr);
+    VirtualFree(_os->slab, 0, MEM_RELEASE);
+  }
+  free_blocks(_os->blocks);
+  if (_os->proxy != INVALID_HANDLE_VALUE)
+    CloseHandle(_os->proxy);
+}
+
+int PcieTransport::msi_fd() const { return -1; }
+
+bool PcieTransport::setup_msi() { return false; }
+
+bool PcieTransport::open_device(const std::string &bdf) {
+  (void)bdf;
+  const GUID *iface = &GUID_DEVINTERFACE_WINAWDL_REGPROXY;
+  HDEVINFO set = SetupDiGetClassDevsW(iface, nullptr, nullptr,
+                                      DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+  if (set == INVALID_HANDLE_VALUE) {
+    _logger->error("PcieTransport: device enumeration failed ({})",
+                   GetLastError());
+    return false;
+  }
+
+  SP_DEVICE_INTERFACE_DATA data{};
+  data.cbSize = sizeof(data);
+  if (SetupDiEnumDeviceInterfaces(set, nullptr, iface, 0, &data)) {
+    DWORD size = 0;
+    SetupDiGetDeviceInterfaceDetailW(set, &data, nullptr, 0, &size, nullptr);
+    std::vector<uint8_t> storage(size);
+    auto *detail =
+        reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W *>(storage.data());
+    detail->cbSize = sizeof(*detail);
+    SP_DEVINFO_DATA devinfo{};
+    devinfo.cbSize = sizeof(devinfo);
+    wchar_t instance_id[MAX_DEVICE_ID_LEN] = {};
+    if (SetupDiGetDeviceInterfaceDetailW(set, &data, detail, size, nullptr,
+                                         &devinfo) &&
+        SetupDiGetDeviceInstanceIdW(set, &devinfo, instance_id,
+                                    MAX_DEVICE_ID_LEN, nullptr)) {
+      _pci_vid = instance_id_field(instance_id, L"VEN_");
+      _pci_did = instance_id_field(instance_id, L"DEV_");
+      _os->proxy = CreateFileW(detail->DevicePath, GENERIC_READ | GENERIC_WRITE,
+                               0, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL,
+                               nullptr);
+    }
+  }
+  const DWORD open_error = GetLastError();
+  SetupDiDestroyDeviceInfoList(set);
+  if (_os->proxy == INVALID_HANDLE_VALUE) {
+    _logger->error("PcieTransport: register proxy not openable ({}): is the "
+                   "driver bound to the card, the process elevated, and no "
+                   "other client running?",
+                   open_error);
+    return false;
+  }
+
+  REGPROXY_INFO info{};
+  DWORD returned = 0;
+  if (!DeviceIoControl(_os->proxy, IOCTL_REGPROXY_GET_INFO, nullptr, 0, &info,
+                       sizeof(info), &returned, nullptr)) {
+    _logger->error("PcieTransport: register proxy GET_INFO failed ({})",
+                   GetLastError());
+    return false;
+  }
+  if (info.version != REGPROXY_VERSION) {
+    _logger->error("PcieTransport: register proxy speaks version {}, this "
+                   "build needs {} — reinstall the driver",
+                   info.version, REGPROXY_VERSION);
+    return false;
+  }
+  _mmio_len = info.bar_len;
+  _logger->info("PcieTransport: register proxy opened, BAR2 {} KiB at 0x{:x}",
+                _mmio_len / 1024, info.bar_phys);
+  return true;
+}
+
+bool PcieTransport::setup_config_space() {
+  if (_pci_vid == 0 || _pci_did == 0) {
+    _logger->error("PcieTransport: PCI ids not found in the device instance id");
+    return false;
+  }
+  _logger->info("PcieTransport: PCI device {:04x}:{:04x}; config space is out "
+                "of reach here, bus mastering and ASPM stay as Windows set them",
+                _pci_vid, _pci_did);
+  return true;
+}
+
+bool PcieTransport::cfg_read(uint32_t, void *, size_t) { return false; }
+
+bool PcieTransport::cfg_write(uint32_t, const void *, size_t) { return false; }
+
+uint32_t PcieTransport::reg_read(uint32_t off, size_t width) {
+  REGPROXY_OP op{};
+  op.offset = off;
+  op.width = static_cast<unsigned char>(width);
+  op.kind = REGPROXY_READ;
+  DWORD returned = 0;
+  if (DeviceIoControl(_os->proxy, IOCTL_REGPROXY_BATCH, &op, sizeof(op), &op,
+                      sizeof(op), &returned, nullptr))
+    return op.value;
+  if (!_os->io_error_logged.exchange(true))
+    _logger->error("PcieTransport: register read 0x{:x} failed ({})", off,
+                   GetLastError());
+  /* What a device that stopped answering reads as; callers already cope. */
+  return 0xFFFFFFFFu >> (8 * (4 - width));
+}
+
+void PcieTransport::reg_write(uint32_t off, size_t width, uint32_t v) {
+  REGPROXY_OP op{};
+  op.offset = off;
+  op.value = v;
+  op.width = static_cast<unsigned char>(width);
+  op.kind = REGPROXY_WRITE;
+  DWORD returned = 0;
+  if (!DeviceIoControl(_os->proxy, IOCTL_REGPROXY_BATCH, &op, sizeof(op), &op,
+                       sizeof(op), &returned, nullptr) &&
+      !_os->io_error_logged.exchange(true))
+    _logger->error("PcieTransport: register write 0x{:x} failed ({})", off,
+                   GetLastError());
+}
+
+bool PcieTransport::init_dma() {
+  const size_t need = (_dma->slab_bytes() + kBlockBytes - 1) / kBlockBytes;
+  if (!enable_lock_memory_privilege()) {
+    _logger->error("PcieTransport: SeLockMemoryPrivilege is not available — "
+                   "run elevated");
+    return false;
+  }
+
+  const unsigned address_bits = _dma->dma_address_bits();
+  const ULONG_PTR limit_frame = ULONG_PTR{1} << (address_bits - kPageShift);
+  const size_t low_need =
+      (_dma->low_slab_bytes() + kBlockBytes - 1) / kBlockBytes;
+  std::vector<size_t> requests;
+  for (size_t factor : kOverRequest)
+    requests.push_back(need * factor);
+  requests.push_back(kRequestEverything);
+  for (size_t request : requests) {
+    std::vector<ULONG_PTR> frames = allocate_blocks(request);
+    _os->blocks = take_lowest_blocks(frames, need, kPagesPerBlock, limit_frame,
+                                     low_need, kFrameAt4GiB);
+    free_blocks(frames);
+    if (!_os->blocks.empty())
+      break;
+  }
+  if (_os->blocks.empty()) {
+    _logger->error("PcieTransport: could not get {} locked 2 MiB blocks within "
+                   "{} address bits, {} of them below 4 GiB — free memory is "
+                   "too fragmented; try after a reboot",
+                   need, address_bits, low_need);
+    return false;
+  }
+
+  const size_t slab_len = need * kBlockBytes;
+  _os->slab = static_cast<uint8_t *>(VirtualAlloc(
+      nullptr, slab_len, MEM_RESERVE | MEM_PHYSICAL, PAGE_READWRITE));
+  if (!_os->slab) {
+    _logger->error("PcieTransport: reserving the slab view failed ({})",
+                   GetLastError());
+    return false;
+  }
+  /* A block maps as its 512 consecutive 4 KiB frames; the documented large
+   * page flags are refused for AWE views. */
+  std::vector<ULONG_PTR> pages(kPagesPerBlock);
+  for (size_t i = 0; i < need; i++) {
+    for (size_t page = 0; page < kPagesPerBlock; page++)
+      pages[page] = _os->blocks[i] + page;
+    if (!MapUserPhysicalPages(_os->slab + i * kBlockBytes, kPagesPerBlock,
+                              pages.data())) {
+      _logger->error("PcieTransport: mapping slab block {} failed ({})", i,
+                     GetLastError());
+      return false;
+    }
+  }
+  std::memset(_os->slab, 0, slab_len);
+
+  _slab.va = _os->slab;
+  _slab.len = slab_len;
+  _slab.chunk_bytes = kBlockBytes;
+  _slab.chunk_iova.clear();
+  for (ULONG_PTR frame : _os->blocks)
+    _slab.chunk_iova.push_back(static_cast<uint64_t>(frame) * kPageBytes);
+  if (!_dma->attach(_slab))
+    return false;
+
+  for (const DmaQuiesceOp &q : _dma->quiesce_ops()) {
+    REGPROXY_OP op{};
+    op.offset = q.reg;
+    op.value = q.bits;
+    op.width = 4;
+    op.kind = q.set ? REGPROXY_SET_BITS : REGPROXY_CLEAR_BITS;
+    _os->quiesce.push_back(op);
+  }
+  DWORD returned = 0;
+  if (_os->quiesce.empty() ||
+      !DeviceIoControl(
+          _os->proxy, IOCTL_REGPROXY_SET_CLOSE_OPS, _os->quiesce.data(),
+          static_cast<DWORD>(_os->quiesce.size() * sizeof(REGPROXY_OP)),
+          nullptr, 0, &returned, nullptr)) {
+    _logger->error("PcieTransport: could not arm the DMA stop the driver "
+                   "replays on exit ({}) — refusing to enable DMA without it",
+                   GetLastError());
+    return false;
+  }
+  _logger->info("PcieTransport: DMA slab is {} locked 2 MiB blocks, physical "
+                "0x{:x}..0x{:x}, used as bus addresses",
+                need, _slab.chunk_iova.front(),
+                _slab.chunk_iova.back() + kBlockBytes);
+  return true;
+}
+
+} /* namespace devourer */
diff --git a/src/PhysicalBlocks.h b/src/PhysicalBlocks.h
new file mode 100644
index 0000000..f9bf54e
--- /dev/null
+++ b/src/PhysicalBlocks.h
@@ -0,0 +1,38 @@
+#pragma once
+
+/* Choosing DMA blocks by physical address, apart from the operating system
+ * calls that allocate them so the choice can be checked without them. */
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace devourer {
+
+/* Moves the `need` lowest blocks that end at or below `limit_frame` out of
+ * `frames` and returns them in ascending order, provided the first
+ * `low_need` of them also end at or below `low_limit_frame`. Returns nothing,
+ * and takes nothing, otherwise. A block is `block_frames` page frames
+ * starting at its entry. Low blocks are preferred because every device can
+ * reach them, whatever its address width. */
+inline std::vector<uintptr_t> take_lowest_blocks(std::vector<uintptr_t> &frames,
+                                                 size_t need,
+                                                 uintptr_t block_frames,
+                                                 uintptr_t limit_frame,
+                                                 size_t low_need = 0,
+                                                 uintptr_t low_limit_frame = 0) {
+  std::sort(frames.begin(), frames.end());
+  auto fits = [&](size_t count, uintptr_t limit) {
+    return count <= frames.size() &&
+           (count == 0 || frames[count - 1] + block_frames <= limit);
+  };
+  std::vector<uintptr_t> taken;
+  if (fits(need, limit_frame) && fits(low_need, low_limit_frame)) {
+    taken.assign(frames.begin(), frames.begin() + need);
+    frames.erase(frames.begin(), frames.begin() + need);
+  }
+  return taken;
+}
+
+} /* namespace devourer */
diff --git a/src/PreciseDelay.h b/src/PreciseDelay.h
new file mode 100644
index 0000000..f3c2600
--- /dev/null
+++ b/src/PreciseDelay.h
@@ -0,0 +1,24 @@
+#pragma once
+
+/* A delay that lasts about as long as it says.
+ *
+ * std::this_thread::sleep_for rounds up to the scheduler tick, and on Windows
+ * that tick can be 15.6 ms: a 1000 x 50 us register poll meant to give up
+ * after 50 ms takes 15 s there. PreciseDelayWin.cpp spins for the shortest
+ * waits and uses a high-resolution timer for the rest. */
+
+#include <chrono>
+#include <cstdint>
+#include <thread>
+
+namespace devourer {
+
+#if defined(_WIN32)
+void precise_delay_us(uint32_t us);
+#else
+inline void precise_delay_us(uint32_t us) {
+  std::this_thread::sleep_for(std::chrono::microseconds(us));
+}
+#endif
+
+} /* namespace devourer */
diff --git a/src/PreciseDelayWin.cpp b/src/PreciseDelayWin.cpp
new file mode 100644
index 0000000..e41a944
--- /dev/null
+++ b/src/PreciseDelayWin.cpp
@@ -0,0 +1,49 @@
+#include "PreciseDelay.h"
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+
+namespace devourer {
+
+namespace {
+
+/* Below this a timer's wake-up latency exceeds the wait itself. */
+constexpr uint32_t kSpinBelowUs = 100;
+
+/* High-resolution timers (Windows 10 1803+) wake within about half a
+ * millisecond whatever the system tick is. One per thread, closed with it. */
+HANDLE thread_timer() {
+  struct Timer {
+    HANDLE handle = CreateWaitableTimerExW(
+        nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+        TIMER_ALL_ACCESS);
+    ~Timer() {
+      if (handle)
+        CloseHandle(handle);
+    }
+  };
+  thread_local Timer timer;
+  return timer.handle;
+}
+
+} /* namespace */
+
+void precise_delay_us(uint32_t us) {
+  if (us < kSpinBelowUs) {
+    const auto deadline =
+        std::chrono::steady_clock::now() + std::chrono::microseconds(us);
+    while (std::chrono::steady_clock::now() < deadline)
+      YieldProcessor();
+    return;
+  }
+  LARGE_INTEGER due;
+  due.QuadPart = -static_cast<LONGLONG>(us) * 10; /* relative, 100 ns units */
+  const HANDLE timer = thread_timer();
+  if (timer && SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE))
+    WaitForSingleObject(timer, INFINITE);
+  else
+    Sleep((us + 999) / 1000);
+}
+
+} /* namespace devourer */
